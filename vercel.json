{
  "version": 2,
  "buildCommand": "npx vite build && cp dist/public/index.html api/template.html",
  "outputDirectory": "dist/public",
  "installCommand": "node script/prepare-vercel-lock.cjs && npm ci --registry=https://registry.npmjs.org",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/test",
      "destination": "/api/test"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/product/:id",
      "destination": "/api/index"
    },
    {
      "source": "/track",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/test.ts": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/payments/redotpay/recover",
      "schedule": "0 0 * * *"
    }
  ]
}
